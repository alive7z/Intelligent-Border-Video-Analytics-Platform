# Copy this file to .env and replace every REPLACE_ME value before deployment.
# The deployment scripts read this file as data; they never execute it.

# Required database settings
DB_NAME=ibvap
DB_USER=ibvap_app
DB_PASSWORD=REPLACE_ME_WITH_A_LONG_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_ME_WITH_A_DIFFERENT_LONG_RANDOM_PASSWORD
DB_CONNECTION_LIMIT=10

# Required application secrets (use independent values)
JWT_SECRET=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRES_IN=8h
JWT_ISSUER=ibvap-backend
JWT_AUDIENCE=ibvap-frontend
AI_SERVICE_TOKEN=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PREVIEW_TOKEN_SECRET=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PREVIEW_TOKEN_TTL_SECONDS=60

# Public gateway
PUBLIC_ORIGIN=http://localhost
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443
NGINX_CONFIG_FILE=./infra/nginx/nginx.conf
TLS_CERT_DIR=./certs
HEALTHCHECK_URL=http://127.0.0.1

# Persistent bind mounts. EASYOCR_MODEL_DIR must be an absolute host path.
EVIDENCE_HOST_PATH=./storage
AI_MODEL_DIR=./ai_engine/models/weights
EASYOCR_MODEL_DIR=/absolute/path/to/.EasyOCR/model

# AI runtime
NODE_INTEGRATION_ENABLED=true
YOLO_DEVICE=auto
CONTEXT_TZ=Asia/Kolkata
AI_INTERNAL_URL=http://ai-engine:8001

# Optional Compose profiles: comma-separated cache,ledger,monitoring
COMPOSE_PROFILES=

# Redis is optional. Set true when COMPOSE_PROFILES includes cache.
REDIS_ENABLED=false
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=ibvap
REDIS_CAMERA_STATUS_TTL_SECONDS=15
CAMERA_RUNTIME_KEY_PREFIX=ibvap:camera
CAMERA_RUNTIME_TTL_SECONDS=15

# Permissioned ledger is optional. Enable both settings together.
BLOCKCHAIN_ENABLED=false
LEDGER_NODE_TOKEN=
LEDGER_CHAIN_ID=51201
LEDGER_NETWORK=ibvap-permissioned-poa
LEDGER_BATCH_SIZE=64

# Optional monitoring profile. Prometheus/Grafana bind to loopback by default.
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Security and evidence defaults
DEMO_MODE=false
PREVIEW_ENABLED=true
EVIDENCE_INTEGRITY_ENABLED=true
EVIDENCE_SIGNING_KEY_ID=ev-key-v1
EVIDENCE_SIGNING_PRIVATE_KEY=
EVIDENCE_SIGNING_PUBLIC_KEY=
EVIDENCE_ENCRYPTION_ENABLED=false
EVIDENCE_ACTIVE_KEY_ID=ev-enc-v1
EVIDENCE_MASTER_KEY=
EVIDENCE_KEY_V2=
EVIDENCE_KEY_V2_ID=ev-enc-v2
MFA_ADMIN_REQUIRED=false
MFA_ISSUER=IBVAP
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15
SECURITY_AUDIT_ENABLED=true
SECURITY_METRICS_ENABLED=true
CORS_ALLOWED_ORIGINS=
ENABLE_HSTS=false
