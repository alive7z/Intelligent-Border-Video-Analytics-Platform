# Internal AI/HTTP service host + port
ADAPTIVE_SECONDARY_ENABLED=true
SECONDARY_BUDGET_FRACTION=0.25
SECONDARY_MAX_FRAME_AGE_MS=1500

AI_HOST=127.0.0.1
AI_PORT=8001

# Node.js backend REST base URL
NODE_API_URL=http://localhost:5001/api

# Service-to-service token (must match backend AI_SERVICE_TOKEN)
NODE_AI_SERVICE_TOKEN=

# Enable sending observations to Node.js
NODE_INTEGRATION_ENABLED=true

# Local MP4 source for testing
VIDEO_SOURCE=

# Frame sampling
FRAME_SAMPLE_FPS=5

# Preprocessing output dimensions
FRAME_WIDTH=1280
FRAME_HEIGHT=720

# Bounded frame buffer
FRAME_BUFFER_SIZE=10

# Reported service name
AI_SERVICE_NAME=IBVAP-AI

# Logging
AI_ENGINE_LOG_LEVEL=INFO
PIPELINE_TRACE_ENABLED=false
PIPELINE_TRACE_INTERVAL_SECONDS=1

# App environment
APP_ENV=development

# YOLO Detection
YOLO_MODEL=yolo11n.pt
YOLO_CONFIDENCE=0.45
YOLO_IOU=0.50
YOLO_DEVICE=auto

# Tracking
TRACKER=bytetrack.yaml
TRACK_CONFIRM_FRAMES=2
TRACK_HISTORY_LENGTH=30

# Camera identity
AI_CAMERA_CODE=CAM-01

# Phase 12 — ANPR (license-plate detection + OCR)
ANPR_ENABLED=true
ANPR_MODEL_PATH=license_plate_detector.pt
ANPR_PROCESS_EVERY_N_FRAMES=2
ANPR_CONFIRM_READS=2
ANPR_MIN_OCR_CONFIDENCE=0.6

# Phase 12 — Face detection (DETECTION ONLY, no recognition)
FACE_DETECTION_ENABLED=true
FACE_MODEL_PATH=face_detection_yunet_2023mar.onnx
FACE_PROCESS_EVERY_N_FRAMES=2
FACE_CONFIRM_FRAMES=2
FACE_DETECTION_CONFIDENCE=0.50
FACE_MIN_SIZE=30
# Capture a detection-only face crop as evidence for every FACE_DETECTED event.
FACE_EVIDENCE_ENABLED=true

# Phase 13 — Live camera / streaming (run with `--camera-code <CODE>`)
STREAM_CONNECT_TIMEOUT_SECONDS=10
STREAM_READ_TIMEOUT_SECONDS=8
STREAM_STALE_SECONDS=5
STREAM_RECONNECT_BASE_SECONDS=1
STREAM_RECONNECT_MAX_SECONDS=15
STREAM_RECONNECT_STABLE_SECONDS=5
STREAM_HEARTBEAT_SECONDS=5
# Number of consecutive invalid frame reads tolerated before the live loop
# closes + reconnects (a new stream session resets track/context/risk state).
STREAM_MAX_CONSECUTIVE_READ_FAILURES=5
# Keep the same stream session across short OpenCV/FFmpeg frame gaps. The reader
# is rebuilt only after both this duration and the failure count are exceeded.
STREAM_NO_FRAME_TOLERANCE_SECONDS=5
# Re-fetch the camera source config from Node this often (RTSP/FPS changes made
# on the website are picked up automatically and the source reconnects).
SOURCE_CONFIG_REFRESH_SECONDS=10
# Re-apply camera context config (zones/fences) this often without a restart.
CONTEXT_CONFIG_REFRESH_SECONDS=30

# Night-movement detection timezone (deployments outside UTC MUST set this so
# NIGHT_MOVEMENT matches local night hours instead of UTC).
CONTEXT_TZ=Asia/Kolkata

# Phase 13 — Live HTTP MJPEG preview (served by Node at /api/preview/<token>)
PREVIEW_ENABLED=true
PREVIEW_FPS=10
PREVIEW_WIDTH=1280
PREVIEW_JPEG_QUALITY=80
PREVIEW_ANNOTATED=true

# Phase 13 — Redis runtime status (optional; degrades to no-op when Redis is down)
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=ibvap
REDIS_CAMERA_STATUS_TTL_SECONDS=15
