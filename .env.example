# Root environment template
# Copy to .env and fill in the correct values for your environment.

APP_NAME=IBVAP
APP_ENV=development
APP_PORT=3000

# Frontend
VITE_API_BASE_URL=http://localhost:3001
VITE_WS_URL=http://localhost:3001

# Backend
BACKEND_PORT=3001
JWT_SECRET=replace-with-long-random-secret
SESSION_SECRET=replace-with-long-random-secret
CORS_ORIGIN=http://localhost:5173

# Database (configure later after selecting the SQL engine)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ibvap
DB_USER=ibvap_user
DB_PASSWORD=change-me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AI Engine
AI_ENGINE_HOST=0.0.0.0
AI_ENGINE_PORT=8000
AI_ENGINE_LOG_LEVEL=INFO

# Storage
EVIDENCE_BASE_PATH=./storage
SNAPSHOT_PATH=./storage/snapshots
CLIP_PATH=./storage/clips

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002

# Camera / stream placeholders
RTSP_URL=rtsp://camera.example/stream
