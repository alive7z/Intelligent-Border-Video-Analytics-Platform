# IBVAP local development topology
# Component-specific .env files remain authoritative. Never commit real secrets.

# Frontend (Vite :5173)
VITE_API_BASE_URL=http://localhost:5001/api
VITE_WS_URL=http://localhost:5001

# Backend (Express :5001)
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:5173
API_PREFIX=/api
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
AI_SERVICE_TOKEN=replace-with-a-long-random-service-token
PREVIEW_TOKEN_SECRET=replace-with-a-different-long-random-secret

# MySQL 8.x (:3306)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ibvap
DB_USER=ibvap_app
DB_PASSWORD=replace-with-database-password
DB_CONNECTION_LIMIT=10

# Optional runtime cache (:6379). Local recovery must work when unavailable.
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
CAMERA_RUNTIME_KEY_PREFIX=ibvap:camera
CAMERA_RUNTIME_TTL_SECONDS=15

# AI engine (FastAPI :8001)
AI_HOST=127.0.0.1
AI_PORT=8001
NODE_API_URL=http://localhost:5001/api
NODE_AI_SERVICE_TOKEN=replace-with-the-same-value-as-AI_SERVICE_TOKEN
AI_CAMERA_CODE=CAM-01
AI_INTERNAL_URL=http://localhost:8001

# Browser-safe preview. Raw RTSP URLs belong only in the database/internal API.
PREVIEW_ENABLED=true
PREVIEW_TOKEN_TTL_SECONDS=60
