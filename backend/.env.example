NODE_ENV=development
PORT=5001

FRONTEND_URL=http://localhost:5173

API_PREFIX=/api

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ibvap
DB_USER=ibvap_app
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# JWT (set a strong, random secret in backend/.env)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# INTERNAL AI SERVICE ONLY — service-to-service token for the Python AI engine.
# Must match ai_engine/.env NODE_AI_SERVICE_TOKEN. Never commit a real value.
AI_SERVICE_TOKEN=

# Phase 13 — Redis runtime status (optional; health flips to degraded when down)
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
CAMERA_RUNTIME_KEY_PREFIX=ibvap:camera
CAMERA_RUNTIME_TTL_SECONDS=15

# Phase 13 — Internal AI engine base URL (used to proxy MJPEG preview frames)
AI_INTERNAL_URL=http://localhost:8001

# Phase 13 — Browser-safe live preview (HMAC token issued over authenticated API)
PREVIEW_ENABLED=true
PREVIEW_TOKEN_TTL_SECONDS=60
PREVIEW_TOKEN_SECRET=
# JSON array of {minimumDurationSeconds, score, optional exclusive}. The default
# implements 10s=15, 20s=25, 30s=40, 45s=50, 60s=65, and >120s=80.
RISK_LOITERING_DURATION_TIERS=[{"minimumDurationSeconds":10,"score":15},{"minimumDurationSeconds":20,"score":25},{"minimumDurationSeconds":30,"score":40},{"minimumDurationSeconds":45,"score":50},{"minimumDurationSeconds":60,"score":65},{"minimumDurationSeconds":120,"score":80,"exclusive":true}]

# Node Alert Manager policy. MEDIUM suspicious activity creates an alert;
# unacknowledged HIGH alerts are escalated to administrators after this delay.
ALERT_MIN_SEVERITY=MEDIUM
ALERT_MIN_RISK_SCORE=40
ALERT_DEDUP_WINDOW_SECONDS=30
HIGH_ALERT_ESCALATION_SECONDS=30

# Maximum retained audit rows, including a cleanup summary when one is written.
AUDIT_LOG_MAX_ROWS=2000

# ─────────────────────────────────────────────────────────────────────────────
# Phase 14/15 — Evidence Integrity, Ledger Anchoring, Blockchain + MFA/security
# ─────────────────────────────────────────────────────────────────────────────

# Evidence ingest → cryptographic integrity pipeline. Server-side SHA-256
# hashing, Ed25519 signing, custody chain are always active; the permissioned
# ledger anchor additionally requires BLOCKCHAIN_ENABLED=true.
EVIDENCE_INTEGRITY_ENABLED=true

# ── On-chain ledger (permissioned PoA). Leave BLOCKCHAIN_ENABLED=false in dev
#    without a ledger node; the backend falls back to PENDING_ANCHOR.
BLOCKCHAIN_ENABLED=false
LEDGER_CHAIN_ID=51201
LEDGER_RPC_URL=http://127.0.0.1:8541
LEDGER_NODE_TOKEN=
LEDGER_NETWORK=ibvap-permissioned-poa
# Audit-log batches are anchored to the ledger every ~30 s; batch size in rows.
LEDGER_BATCH_SIZE=64

# ── Evidence signing (Ed25519). Key id is referenced by integrity records.
EVIDENCE_SIGNING_KEY_ID=ev-key-v1
# Optional PEM overrides; when unset a development keypair is generated in-memory
# (sessions only, not persisted).
EVIDENCE_SIGNING_PRIVATE_KEY=
EVIDENCE_SIGNING_PUBLIC_KEY=

# ── Evidence encryption at rest (AES-256-GCM, feature-flagged OFF by default).
EVIDENCE_ENCRYPTION_ENABLED=false
EVIDENCE_ACTIVE_KEY_ID=ev-enc-v1
# 32-byte hex (64 hex chars) key; used for evidence-file encryption and MFA
# secret encryption at rest. Set this before enabling encryption or MFA.
EVIDENCE_MASTER_KEY=
# Optional rotated key kept for decrypting older records.
EVIDENCE_KEY_V2=
EVIDENCE_KEY_V2_ID=ev-enc-v2

# ── Admin MFA (RFC 6238 TOTP). Enrolment is ADMINISTRATOR-only and requires
#    EVIDENCE_MASTER_KEY so TOTP secrets can be encrypted at rest.
MFA_ADMIN_REQUIRED=false
MFA_ISSUER=IBVAP
MFA_WINDOW=1
# Brute-force lockout: lock account after threshold attempts for N minutes.
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15

# ── Security configuration
# Enforce mutual TLS for trusted edge-node calls (requires MTLS_CA_CERT).
MTLS_ENABLED=false
MTLS_CA_CERT=
# NDJSON security-event stream for SIEM ingestion (default storage/security-events.ndjson).
SECURITY_EVENTS_FILE=
SECURITY_AUDIT_ENABLED=true
SECURITY_METRICS_ENABLED=true
# Extra allowed CORS origins beyond FRONTEND_URL (comma-separated).
CORS_ALLOWED_ORIGINS=
# Strict-Transport-Security: only applied in NODE_ENV=production.
ENABLE_HSTS=false

# ── JWT issuer/audience (kept in sync with frontend)
JWT_ISSUER=ibvap-backend
JWT_AUDIENCE=ibvap-frontend

# ── Secure demo access (SIH exhibitions)
# When true, the Login page shows "Explore Demo" and /auth/demo-login
# authenticates the preconfigured is_demo=1 accounts (one per role), reusing
# the normal JWT/session flow. Keep false in production.
DEMO_MODE=false

# ── Path-safety / integrity lookups (keep local)
EVIDENCE_STORAGE_ROOT=../storage
